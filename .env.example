# Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_DB=laocai_software_db
POSTGRES_USER=laocai_user
POSTGRES_PASSWORD=laocai_secret_dev_pass_2026
POSTGRES_PORT=5432

# Chuỗi kết nối Database cho Backend API & Worker
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=laocai_software_db;Username=laocai_user;Password=laocai_secret_dev_pass_2026;Include Error Detail=true

# Cấu hình Khóa bảo mật ASP.NET Core Data Protection & Session
ASPNETCORE_ENVIRONMENT=Development
DataProtection__KeyPath=./temp_keys

# Cấu hình Lưu trữ tệp tin
FileStorage__RootPath=./temp_storage
FileStorage__MaxFileSizeMB=20
