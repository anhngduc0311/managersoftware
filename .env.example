# Cấu hình Cơ sở dữ liệu PostgreSQL (Port 5436 tránh trùng 5432, 5433, 5435 của project khác)
POSTGRES_DB=laocai_software_db
POSTGRES_USER=laocai_user
POSTGRES_PASSWORD=laocai_secret_dev_pass_2026
POSTGRES_PORT=5436

# Cấu hình Redis Cache (Port 6383 tránh trùng 6379, 6380, 6382)
REDIS_PORT=6383

# Cấu hình Meilisearch (Port 7704 tránh trùng 7700, 7701, 7703)
MEILI_PORT=7704
MEILI_MASTER_KEY=laocai_meili_master_key_2026

# Chuỗi kết nối Database cho Backend API & Worker chạy trên máy Host
ConnectionStrings__DefaultConnection=Host=localhost;Port=5436;Database=laocai_software_db;Username=laocai_user;Password=laocai_secret_dev_pass_2026;Include Error Detail=true

# Cấu hình Môi trường
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# ==========================================
# TÀI KHOẢN QUẢN TRỊ VIÊN MẶC ĐỊNH (SYSTEM ADMIN)
